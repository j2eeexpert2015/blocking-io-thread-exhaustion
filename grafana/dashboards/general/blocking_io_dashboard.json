{
  "title": "Blocking vs Virtual I/O Metrics",
  "uid": "blocking-vs-virtual-metrics",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 3,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Blocking I/O Total Execution Time (sum)",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(simulate_blockingio_execution_seconds_sum[1m]))",
          "legendFormat": "Blocking Total Exec Time",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Virtual I/O Total Execution Time (sum)",
      "id": 2,
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(simulate_virtual_execution_seconds_sum[1m]))",
          "legendFormat": "Virtual Total Exec Time",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Blocking I/O Max Duration",
      "id": 3,
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "max(simulate_blockingio_execution_seconds_max)",
          "legendFormat": "Blocking Max Time",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Virtual I/O Max Duration",
      "id": 4,
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "max(simulate_virtual_execution_seconds_max)",
          "legendFormat": "Virtual Max Time",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Blocking I/O Call Count",
      "id": 5,
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(simulate_blockingio_execution_seconds_count[1m]))",
          "legendFormat": "Blocking Calls",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Virtual I/O Call Count",
      "id": 6,
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(simulate_virtual_execution_seconds_count[1m]))",
          "legendFormat": "Virtual Calls",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "time": {
    "from": "now-6h",
    "to": "now"
  }
}
